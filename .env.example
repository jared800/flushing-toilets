# Database (required for durable leads)
DATABASE_URL=

# Email delivery (Resend)
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=leads@flushingtoilets.com
NOTIFY_FROM_NAME=Flushing Toilets

# Safety net: every lead is copied here, including leads that matched no
# partner. REQUIRED while PARTNERS is empty — without it (and RESEND_API_KEY)
# a lead is saved but no human is ever told. NOTIFY_FROM_EMAIL's domain must be
# verified in Resend (flushingtoilets.com DNS records) or sends fail.
LEAD_FALLBACK_EMAIL=

# Internal ops auth. Both are REQUIRED for /admin and /partners to work at all.
# OPS_SESSION_SECRET signs the session cookie — use 32+ random characters.
# ADMIN_ACCESS_CODE is the code entered at /admin/login.
OPS_SESSION_SECRET=
ADMIN_ACCESS_CODE=

# Canonical site origin (used for canonical tags and the sitemap)
SITE_URL=https://www.flushingtoilets.com
VITE_SITE_URL=https://www.flushingtoilets.com

# Optional SMS for emergency leads
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public phone. Leave BOTH empty until a real call-tracking number rings a
# person. Nothing on the site shows a phone number while these are empty.
VITE_PUBLIC_PHONE=
VITE_PUBLIC_PHONE_E164=
